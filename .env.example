DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Leave DB_NAME empty for local SQLite development. Set it to enable PostgreSQL.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=0
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Cloudflare R2 media storage. Fill these in your deployment environment, not Git.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
